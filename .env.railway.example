# Railway Deployment - Environment Variables
# Copy these to Railway project Variables (Dashboard > Your Project > Variables)
# Variables are available at build AND runtime.

# ============ REQUIRED ============
DEPLOYMENT_TARGET=railway
DATABASE_URL=postgresql://user:pass@host:5432/dbname
SESSION_SECRET=your-32-plus-char-random-secret
STRIPE_SECRET_KEY=sk_live_xxxx
VITE_STRIPE_PUBLIC_KEY=pk_live_xxxx

# ============ S3 STORAGE (required for all documents & uploads on Railway) ============
# When set, all object storage (vendor docs, profile/listing images, GET /objects/*) uses S3.
# Optional: STORAGE_PROVIDER=s3 to force S3; STORAGE_PROVIDER=replit to force Replit when both exist.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# Optional: for R2/MinIO
# For R2: S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# ============ CORS (add your Railway URL) ============
# Comma-separated list of allowed origins. Include your Railway public URL.
# Example: https://emchub-production.up.railway.app,https://emchub.com.hk
ALLOWED_ORIGINS=https://emchub.com.hk

# ============ OPTIONAL ============
# NEON_DATABASE_URL - For db:sync-neon: sync schema (and optionally data) from DATABASE_URL to Neon.
#   Set to your Neon Postgres connection string, then: npm run db:sync-neon:dry-run (check) then npm run db:sync-neon
# DB_REJECT_UNAUTHORIZED=true - Enable strict SSL cert verification for DB (default: relaxed for Railway)
# NODE_ENV and PORT are set by Railway automatically
# NODE_ENV=production
# PORT=5000

# ============ OBJECT STORAGE (Replit-specific, not supported on Railway) ============
# Image/file uploads use Replit Object Storage. On Railway, these features
# will fail until alternative storage (S3, GCS, etc.) is configured.
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=

# ============ STRIPE WEBHOOK (recommended for production) ============
# For payment_intent.succeeded webhook verification. Add when ready.
# STRIPE_WEBHOOK_SECRET=whsec_xxxx
